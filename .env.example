# Copy to .env (gitignored) and fill in. Never commit .env.
# Only *.preprod.mozark.ai or *.dev.mozark.ai hosts are accepted.
MOZARK_BASE_URL=https://app-studio-be.preprod.mozark.ai
# SSO bearer (without the "Bearer " prefix). Copy from a signed-in App Studio preprod session.
MOZARK_TOKEN=
MOZARK_ORG_ID=
MOZARK_APP_ID=
MOZARK_PROJECT_ID=
# android | ios
MOZARK_PLATFORM=android
# Comma-separated device serials
MOZARK_DEVICES=
# Optional
MOZARK_TEST_CASE_IDS=
MOZARK_MAX_TEST_MINUTES=10
MOZARK_TIMEOUT_MINUTES=45
